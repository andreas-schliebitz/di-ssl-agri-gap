# Copy to .env and fill in. .env is gitignored and should be chmod 600.

# --- MLflow tracking ---------------------------------------------------------
USE_MLFLOW=true
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_TRACKING_INSECURE_TLS=false

EXPERIMENT_NAME=di-ssl-agri-gap-pretrain
EXPERIMENT_EVAL_NAME=di-ssl-agri-gap-eval

# --- paths -------------------------------------------------------------------
# Source: the read-only HuggingFace snapshot of iNatAg-mini (2,958 archives).
INATAG_ZIP_DIR=/cluster/user/aschlieb/asyncio/datasets/iNatAg-mini

# Working root. Holds raw/, img256/, img256_train/, manifest and reports.
DATA_ROOT=/cluster/user/aschlieb/asyncio/datasets/iNatAg-mini-work

# Fast staging target copied from DATA_ROOT at the start of each session.
SHM_ROOT=/dev/shm/inatag-mini

# Local run outputs (checkpoints, feature caches, logs).
OUT_DIR=out
LOG_DIR=logs
